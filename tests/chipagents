#!/bin/bash
# Mock of `chipagents batch` used by selftest.sh. It parses the documented
# batch options and, per team, passes, fails, crashes or sleeps as MOCK_PLAN
# says ("team:outcome:seconds,..."); it logs whether --allow-edits was given.
[[ "$1" == batch ]] || { echo "unknown subcommand $1" >&2; exit 2; }; shift
pf= out= stats= name= edits=() extra=()
while [[ $# -gt 0 ]]; do case "$1" in
  --prompt-file) pf=$2; shift 2;; --output) out=$2; shift 2;; --stats-file) stats=$2; shift 2;; --name) name=$2; shift 2;;
  --thinking|--provider) extra+=("$1=$2"); shift 2;;
  --allow-edits) shift; while [[ $# -gt 0 && $1 != --* ]]; do edits+=("$1"); shift; done;;
  *) echo "unknown option $1" >&2; exit 2;; esac; done
prompt=$(cat "$pf")
k=$(grep -oE '(team|task|investigator) [0-9]+ of' <<< "$prompt" | head -1 | grep -oE '[0-9]+')
echo "$name edits=${#edits[@]} extra=${extra[*]:-} inner=${CHIPAGENTS_HOOKS_INNER:-} cwd=$(basename "$PWD")" >> "$MOCK_LOG"
plan=$(tr ',' '\n' <<< "${MOCK_PLAN:-}" | grep "^${k:-0}:" | head -1)
outcome=$(cut -d: -f2 <<< "$plan"); delay=$(cut -d: -f3 <<< "$plan")
sleep "${delay:-0}"
st=completed; resp="done"
if grep -q 'chip-swarm merge' <<< "$prompt"; then
  n=$(grep -c '^===== REPORT' <<< "$prompt"); resp="MERGED VERDICT from $n reports: H1 survives"
elif grep -q 'investigator' <<< "$prompt"; then
  resp=$'findings...\nVERDICT: '"$([[ $((k % 2)) == 1 ]] && echo SUPPORTED || echo REFUTED)"$'\nCONFIDENCE: 70'
else
  case "$outcome" in
    pass) echo ok > answer.txt;;
    passbig) echo ok > answer.txt; seq 1 20 > extra.txt;;
    fail) echo bad > answer.txt;;
    crash) echo "boom" >&2; exit 1;;
    failedstatus) st=failed;;
  esac
fi
[[ -n $out ]] && printf '%s\n' "$resp" > "$out"
[[ -n $stats ]] && printf '{"schemaVersion":1,"status":"%s","tokenUsage":{"totalTokens":%s}}\n' "$st" "$(( ${k:-1} * 1000 ))" > "$stats"
exit 0
